@article{weiss_howbecomefirst_2018,
  title = {How to Become a First Mover? {{Mechanisms}} of Military Innovation and the Development of Drones},
  shorttitle = {How to Become a First Mover?},
  author = {Weiss, Moritz},
  year = {2018},
  month = jun,
  journal = {European Journal of International Security},
  volume = {3},
  number = {2},
  pages = {187--210},
  issn = {2057-5637, 2057-5645},
  doi = {10.1017/eis.2017.15},
  urldate = {2018-05-10},
  abstract = {States generate the hardware of military power by either developing new technologies as first mover or adopting demonstrated technology as second mover. Given that military drones have arguably demonstrated effectiveness and thus proliferate, scholars have produced profound insights into today's second mover dynamics. Yet, the preceding political process of developing this military technology remains poorly understood. The article's objective is to explain how states become first movers of military hardware. To this end, it applies four causal mechanisms of military innovation studies to the historical trajectory of the development of drones. I argue that security threats initially formed state interests in drones. Yet, capacity was necessary for success. Politically induced transfers and cross-sector diffusion supplied technological progress. At the same time, distributional implications and legacy systems constrained the development process, but could ultimately be overcome. This mechanismic pathway results from the process-tracing analysis of two separate, but related trajectories in Israel and the United States since the 1970s. Given within-case variation, a sequencing and domain-of-application perspective allows the formulation of scope conditions of the mechanisms behind military innovation. This contributes to a historically contingent, yet generalisable, understanding of the political process of how states generate military power.},
  langid = {english},
  keywords = {Drones,Israel,Material Power,Military Innovation,United States,unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/287X47IY/Weiss_2018_How to become a first mover.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ATLNIRKH/Weiss_2018_How to become a first mover.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/CTP3R3NJ/Weiss_2018_How to become a first mover.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3TPBEXW4/F019C614AC1B902F63C413717123201C.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/4AG8YN6I/F019C614AC1B902F63C413717123201C.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/G3XAINN5/F019C614AC1B902F63C413717123201C.html}
}

@article{weiss_natohardplace_2019,
  title = {Between {{NATO}} and a Hard Place: Defence Spending Debate in {{Germany}} and {{Czechia}}},
