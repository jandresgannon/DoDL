  title = {Make, {{Buy}} or {{Ally}}? {{Theoretical Perspectives}} on {{Knowledge Process Outsourcing}} through {{Alliances}}},
  shorttitle = {Make, {{Buy}} or {{Ally}}?},
  author = {Mudambi, Susan M. and Tallman, Stephen},
