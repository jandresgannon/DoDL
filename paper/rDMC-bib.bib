  keywords = {done,Law / International,Political Science / Intergovernmental Organizations,Political Science / International Relations / Diplomacy,Political Science / International Relations / General,Political Science / International Relations / Treaties,Political Science / Peace,Political Science / Political Process / General,Political Science / World / General},
