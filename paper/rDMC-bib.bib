@article{kaufman_fragmentationconsolidationinternational_1997,
  title = {The {{Fragmentation}} and {{Consolidation}} of {{International Systems}}},
  author = {Kaufman, Stuart J.},
  year = {1997},
  journal = {International Organization},
  volume = {51},
  number = {2},
