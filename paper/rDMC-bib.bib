@article{suchman_militaryprocurementrational_1992,
  title = {Military Procurement as Rational Myth: {{Notes}} on the Social Construction of Weapons Proliferation},
  shorttitle = {Military Procurement as Rational Myth},
  author = {Suchman, Mark C. and Eyre, Dana P.},
  year = {1992},
