@article{wohlstetter_strategicalliancesaction_2005,
  title = {Strategic {{Alliances}} in {{Action}}: {{Toward}} a {{Theory}} of {{Evolution}}},
  shorttitle = {Strategic {{Alliances}} in {{Action}}},
