@article{talmadge_emergingtechnologyintrawar_2019,
  title = {Emerging Technology and Intra-War Escalation Risks: {{Evidence}} from the {{Cold War}}, Implications for Today},
  shorttitle = {Emerging Technology and Intra-War Escalation Risks},
  author = {Talmadge, Caitlin},
  year = {2019},
  month = sep,
  journal = {Journal of Strategic Studies},
  volume = {42},
  number = {6},
  pages = {864--887},
  issn = {0140-2390},
  doi = {10.1080/01402390.2019.1631811},
  urldate = {2019-09-03},
  abstract = {Will emerging technologies increase the risk of conflict escalation? This paper develops a framework for evaluating the role of technology in different types of intra-war escalation. It then uses the framework to probe empirically the possible role of technology in escalation through three carefully chosen cases from Cold War. The findings largely cast doubt on the idea of emerging technologies as an independent, primary driver of otherwise avoidable escalation, suggesting instead that technology more likely functions as an intervening variable -- a sometimes necessary, but rarely sufficient, condition for escalation. The conclusion explores the implications of this analysis for the future.},
