  langid = {english},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3D9NLJWY/Beek et al_Hierarchy and war.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/IND65S68/ajps.html}
