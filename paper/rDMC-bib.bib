  urldate = {2022-04-20},
  abstract = {Gross domestic product (GDP), GDP per capita, and population are central to the study of politics and economics broadly, and conflict processes in particular. Despite the prominence of these variables in empirical research, existing data lack historical coverage and are assumed to be measured without error. We develop a latent variable modeling framework that expands data coverage (1500 AD--2018 AD) and, by making use of multiple indicators for each variable, provides a principled framework to estimate uncertainty for values for all country-year variables relative to one another. Expanded temporal coverage of estimates provides new insights about the relationship between development and democracy, conflict, repression, and health. We also demonstrate how to incorporate uncertainty in observational models. Results show that the relationship between repression and development is weaker than models that do not incorporate uncertainty suggest. Future extensions of the latent variable model can address other forms of systematic measurement error with new data, new measurement theory, or both.},
  langid = {english},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ATJJPEGW/Fariss et al. - 2022 - New Estimates of Over 500 Years of Historic GDP an.pdf}
}

