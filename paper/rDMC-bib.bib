@article{horowitz_poormansatomic_2014,
  title = {Poor {{Man}}'s {{Atomic Bomb}}? {{Exploring}} the {{Relationship}} between ''{{Weapons}} of {{Mass Destruction}}''},
  shorttitle = {Poor {{Man}}'s {{Atomic Bomb}}?},
