@article{caimo_statisticalnetworkanalysis_2022,
  title = {Statistical {{Network Analysis}} with {{Bergm}}},
  author = {Caimo, Alberto and Bouranis, Lampros and Krause, Robert and Friel, Nial},
  year = {2022},
  month = sep,
  journal = {Journal of Statistical Software},
  volume = {104},
  pages = {1--23},
  issn = {1548-7660},
  doi = {10.18637/jss.v104.i01},
  urldate = {2022-10-04},
  abstract = {Recent advances in computational methods for intractable models have made network data increasingly amenable to statistical analysis. Exponential random graph models (ERGMs) emerged as one of the main families of models capable of capturing the complex dependence structure of network data in a wide range of applied contexts. The Bergm package for R has become a popular package to carry out Bayesian parameter inference, missing data imputation, model selection and goodness-of-fit diagnostics for ERGMs. Over the last few years, the package has been considerably improved in terms of efficiency by adopting some of the state-of-the-art Bayesian computational methods for doublyintractable distributions. Recently, version 5 of the package has been made available on CRAN having undergone a substantial makeover, which has made it more accessible and easy to use for practitioners. New functions include data augmentation procedures based on the approximate exchange algorithm for dealing with missing data, adjusted pseudolikelihood and pseudo-posterior procedures, which allow for fast approximate inference of the ERGM parameter posterior and model evidence for networks on several thousands nodes.},
  copyright = {Copyright (c) 2022 Alberto Caimo, Lampros Bouranis, Robert Krause, Nial Friel},
  langid = {english},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/6R3ZGUEC/Caimo et al_2022_Statistical Network Analysis with Bergm.pdf}
}

@article{calcara_marketsizepolitical_2021,
  title = {Market {{Size}} and the {{Political Economy}} of {{European Defense}}},
  author = {Calcara, Antonio and Sim{\'o}n, Luis},
  year = {2021},
  month = oct,
  journal = {Security Studies},
  volume = {30},
  number = {5},
  pages = {860--892},
  publisher = {Routledge},
  issn = {0963-6412},
  doi = {10.1080/09636412.2021.2023625},
  urldate = {2022-01-25},
  abstract = {There is an intense debate in international relations scholarship on whether the benefits accrued by arms production globalization outweigh the risks of depending on foreign suppliers. Europe is an interesting case: although regional protection could help Europeans mitigate exposure to global actors, the prospect of regional integration generates concerns about autonomy within Europe itself. We depict European defense cooperation as a ``two-level playing field,'' whereby market size informs a country's hedging between global-external and European-internal competitors. First tiers push for defense market integration because they expect to be strengthened vis-{\`a}-vis global players but also because market size gives them a competitive advantage over fellow Europeans. Second tiers resist market integration, as they worry it might lead to first-tier dominance. To probe our hypotheses, we examine the behavior of two first tiers (France and Germany) and two second tiers (Poland and Sweden) in the context of the European Defense Fund.},
  keywords = {nosource}
}

@article{calcara_whydroneshave_2022,
  title = {Why {{Drones Have Not Revolutionized War}}: {{The Enduring Hider-Finder Competition}} in {{Air Warfare}}},
  shorttitle = {Why {{Drones Have Not Revolutionized War}}},
  author = {Calcara, Antonio and Gilli, Andrea and Gilli, Mauro and Marchetti, Raffaele and Zaccagnini, Ivan},
  year = {2022},
  month = apr,
  journal = {International Security},
  volume = {46},
  number = {4},
  pages = {130--171},
  issn = {0162-2889},
  doi = {10.1162/isec_a_00431},
  urldate = {2022-06-01},
  abstract = {According to the accepted wisdom in security studies, unmanned aerial vehicles, also known as drones, have revolutionizing effects on war and world politics. Drones allegedly tilt the military balance in favor of the offense, reduce existing asymmetries in military power between major and minor actors, and eliminate close combat from modern battlefields. A new theory about the hider-finder competition between air penetration and air defense shows that drones are vulnerable to air defenses and electronic warfare systems, and that they require support from other force structure assets to be effective. This competition imposes high costs on those who fail to master the set of tactics, techniques, procedures, technologies, and capabilities necessary to limit exposure to enemy fire and to detect enemy targets. Three conflicts that featured extensive employment of drones---the Western Libya military campaign of the second Libyan civil war (2019--2020), the Syrian civil war (2011--2021), and the Armenia-Azerbaijan conflict over Nagorno-Karabakh (2020)---probe the mechanisms of the theory. Drones do not by themselves produce the revolutionary effects that many have attributed to them.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/YKT48NZE/Calcara et al_2022_Why Drones Have Not Revolutionized War.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/BF3LRK3Z/Why-Drones-Have-Not-Revolutionized-War-The.html}
}

@book{calder_asiadeadlytriangle_1997,
