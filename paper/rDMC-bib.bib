@article{grand_resourceallocationfirm_2004,
  title = {Resource Allocation beyond Firm Boundaries: {{A}} Multi-Level Model for {{Open Source}} Innovation},
  shorttitle = {Resource Allocation beyond Firm Boundaries},
  author = {Grand, Simon and {von Krogh}, Georg and Leonard, Dorothy and Swap, Walter},
  year = {2004},
  month = dec,
  journal = {Long Range Planning},
  series = {Boundaries and {{Innovation}}},
  volume = {37},
