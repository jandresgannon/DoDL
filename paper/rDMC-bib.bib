@book{mansfield_economicinterdependenceinternational_2009a,
  title = {Economic {{Interdependence}} and {{International Conflict}}: {{New Perspectives}} on an {{Enduring Debate}}},
  shorttitle = {Economic {{Interdependence}} and {{International Conflict}}},
