@article{trager_diplomaticcalculusanarchy_2010,
  title = {Diplomatic {{Calculus}} in {{Anarchy}}: {{How Communication Matters}}},
  shorttitle = {Diplomatic {{Calculus}} in {{Anarchy}}},
  author = {Trager, Robert F.},
