@unpublished{craig_measuringtechnologicalcapability_2018,
  title = {Measuring {{Technological Capability}}},
  author = {Craig, Anthony and Early, Bryan and Valeriano, Brandon and Renaud, Karen},
  year = {2018},
  abstract = {Despite the obvious importance of technology in International Relations (IR) and international security scholarship, empirical scholars have not yet developed an appropriate quantitative measure of technological capability. Technological capability, defined in terms of technical knowledge and expertise, theoretically can determine a country's military strength and power position in the international system. So far, the field has lacked a precise conceptualisation thereof. While there are proxy variables that might suggest the technological sophistication of a country, such as levels of economic development as measured by GDP per capita, these measures fail accurately to capture the essence of technological capability. We examine the concept of technology by operationalising a composite index of national technological capability, composed of data on engineering universities, science and technical journal articles, and tertiary education rates. We then test the explanatory power of our measure in a logistic regression model using the possession of supercomputers as our dependent variable. Our results demonstrate both the validity of our measure and offer a way to properly account for technology when explaining international processes.},
  langid = {english},
  keywords = {done},
  annotation = {Working Paper},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/5LXUIINW/Craig et al_2018_Measuring Technological Capability.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/7XWRG232/Craig et al_2018_Measuring Technological Capability.pdf}
}

