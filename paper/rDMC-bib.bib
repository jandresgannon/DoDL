  year = {2012},
  month = oct,
  publisher = {Routledge},
  abstract = {East Asia is a potential area of international conflict, with a number of possible 'flashpoints' and with the absence of strong regional organisations able to deal with conflict resolution. At the same time, global powers frequently get involved in the international politics of the region in order to protect their interests. This book presents a comprehensive overview of the geopolitics of the region. It focuses in particular on the way geographical and historical forces continue to play a key role in shaping international relations here. It considers the role of both regional and international powers, and assesses the risks of war in the region.},
