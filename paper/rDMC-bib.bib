@article{overhage_poolitshare_2013,
  title = {Pool It, Share It, or Lose It: An Economical View on Pooling and Sharing of {{European}} Military Capabilities},
  shorttitle = {Pool It, Share It, or Lose It},
  author = {Overhage, Thomas},
  year = {2013},
  month = dec,
  journal = {Defense \& Security Analysis},
  volume = {29},
  number = {4},
  pages = {323--341},
  issn = {1475-1798},
  doi = {10.1080/14751798.2013.842712},
  urldate = {2017-11-20},
  abstract = {In a general and economical view, this article analyzes methods and mechanisms for the pooling and sharing of military forces and weapons inside the European Union (EU) in times of scarcity. Pooling and sharing could improve the EU military capabilities significantly if differences in location factors were taken into account and all states would focus on their respective strengths. More competition and less concentration are the keys to ensuring guaranteed access to military assets. Pooling and sharing are likely to be successful only if large states enhance their emphasis on collective defense by mutual aid and self-help, and reduce particularistic and parochial interests of local gain. The realm of personnel has the most potential for improvement but any change is likely to generate policy implications.},
  keywords = {done,unsorted},
