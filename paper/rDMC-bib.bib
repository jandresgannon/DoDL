@article{slantchev_militarycoercioninterstate_2005,
  ids = {slantchevMilitaryCoercionInterstate2005},
  title = {Military {{Coercion}} in {{Interstate Crises}}},
  author = {Slantchev, Branislav L.},
  year = {2005},
  month = nov,
  journal = {American Political Science Review},
  volume = {99},
  number = {4},
  pages = {533--547},
  issn = {1537-5943, 0003-0554},
  doi = {10.1017/S0003055405051865},
  urldate = {2016-10-06},
  abstract = {Military mobilization simultaneously sinks costs, because it must be paid for regardless of the outcome, and ties hands, because it increases the probability of winning should war occur. Existing studies neglect this dualism and cannot explain signaling behavior and tacit bargaining well. I present a formal model that incorporates both functions and shows that many existing conclusions about crisis escalation have to be qualified. Contrary to models with either pure sunk costs or tying-hands signaling, bluffing is possible in equilibrium. General monotonicity results that relate the probability of war to an informed player's expected payoff from fighting do not extend to this environment with its endogenous distribution of power. Peace may involve higher military allocations than war. Rational deterrence models also assume that a commitment either does or does not exist. Extending these, I show how the military instrument can create commitments and investigate the difficulties with communicating them.},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/AIP3GWHD/Slantchev_2005_Military Coercion in Interstate Crises.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/HP8HDSZ4/Slantchev_2005_Military Coercion in Interstate Crises.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/VEMSQXWT/Slantchev_2005_Military Coercion in Interstate Crises.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3SUAFWGV/C16200BD52B367EFED470B1BBE9D40EB.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/C9ZS3IPA/C16200BD52B367EFED470B1BBE9D40EB.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/U3IHDG6X/C16200BD52B367EFED470B1BBE9D40EB.html}
}

@book{slantchev_militarythreatscosts_2011,
  title = {Military {{Threats}}: {{The Costs}} of {{Coercion}} and the {{Price}} of {{Peace}}},
  shorttitle = {Military {{Threats}}},
  author = {Slantchev, Branislav L.},
  year = {2011},
  month = feb,
  publisher = {Cambridge University Press},
  address = {Cambridge; New York},
  abstract = {Is military power central in determining which states get their voice heard? Must states run a high risk of war to communicate credible intent? In this book, Slantchev shows that states can often obtain concessions without incurring higher risks when they use military threats. Unlike diplomatic forms of communication, physical military moves improve a state's expected performance in war. If the opponent believes the threat, it will be more likely to back down. Military moves are also inherently costly, so only resolved states are willing to pay these costs. Slantchev argues that powerful states can secure better peaceful outcomes and lower the risk of war, but the likelihood of war depends on the extent to which a state is prepared to use military threats to deter challenges to peace and compel concessions without fighting. The price of peace may therefore be large: states invest in military forces that are both costly and unused.},
  googlebooks = {zZ4Nnah5P6UC},
  isbn = {978-1-139-49305-5},
  langid = {english},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/BK5WBGFZ/Slantchev_2011_Military Threats.pdf}
}

@article{slantchev_politiciansmediadomestic_2006,
  title = {Politicians, the {{Media}}, and {{Domestic Audience Costs}}},
  author = {Slantchev, Branislav L.},
  year = {2006},
  month = jun,
  journal = {International Studies Quarterly},
  volume = {50},
  number = {2},
  pages = {445--477},
  issn = {1468-2478},
  doi = {10.1111/j.1468-2478.2006.00409.x},
  urldate = {2016-12-05},
  abstract = {Domestic audience costs can help leaders establish credible commitments by tying their hands. Most studies assume these costs without explaining how they arise. I link domestic audience costs to the citizens' ability to sanction the leadership for pursuing a policy they would not want if they had the same information about its quality. How can citizens learn about policy quality? I model two information transmission mechanisms: one potentially contaminated by politically motivated strategic behavior (leader and opposition), and another that is noisy and possibly biased (media). In equilibrium, audience costs can arise from strategic sources only in mixed regimes under relatively restrictive conditions, and cannot arise in autocracies or democracies. However, in democratic polities the media can play a mitigating role and does enable leaders to generate audience costs. Still, their ability to do so depends on the institutional protections guaranteeing freedom of the media from political manipulation. Domestic audience costs are not necessarily linear in regime type, as often assumed in applied research.},
  langid = {english},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/T6BTMPQL/Slantchev_2006_Politicians, the Media, and Domestic Audience Costs.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ZPKF43RN/Slantchev_2006_Politicians, the Media, and Domestic Audience Costs.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8TB8LG4G/1819300.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ER63VHC8/abstract.html}
}

@article{slantchev_powerhurtcostly_2003,
  ids = {slantchev_powerhurtcostly_2003a},
  title = {The {{Power}} to {{Hurt}}: {{Costly Conflict}} with {{Completely Informed States}}},
  shorttitle = {The {{Power}} to {{Hurt}}},
  author = {Slantchev, Branislav L.},
  year = {2003},
  journal = {American Political Science Review},
  volume = {97},
  number = {1},
  eprint = {3118225},
  eprinttype = {jstor},
  pages = {123--133},
  issn = {0003-0554},
  doi = {10.2307/3118225},
  urldate = {2017-08-23},
  abstract = {Because war is costly and risky, states have incentives to negotiate and avoid conflict. The common rationalist explanation is that war results from private information and incentives to misrepresent it. By modeling warfare as a costly bargaining process, I show that inefficient fighting can occur in equilibrium under complete information and very general assumptions favoring peace. Specifically, I assume that peace can be supported in equilibrium and that fighting brings no benefits to either state, only costs. Although there exist agreements that Pareto-dominate the final settlement, states may prefer to fight. The result turns on the ability of states to impose costs on their opponents and bear costs in return. The existence of a range of acceptable settlements and the threat to revert to particularly disadvantageous ones make inefficient equilibria possible. A diminished ability to hurt the enemy, not simply military victory, is a major reason to stop fighting.},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8WAUMR3A/Slantchev_2003_The Power to Hurt.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/QC42WHG8/Slantchev_2003_The Power to Hurt.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/HJ3NPHXT/A5E6ACDE2BC8BA884871B68833A07D1B.html}
}

@article{slantchev_principleconvergencewartime_2003,
  title = {The {{Principle}} of {{Convergence}} in {{Wartime Negotiations}}},
  author = {Slantchev, Branislav L.},
  year = {2003},
  month = nov,
  journal = {American Political Science Review},
  volume = {97},
  number = {4},
  pages = {621--632},
  issn = {1537-5943, 0003-0554},
  doi = {10.1017/S0003055403000911},
  urldate = {2017-09-28},
  abstract = {If war results from disagreement about relative strength, then it ends when opponents learn enough about each other. Learning occurs when information is revealed by strategically manipulable negotiation behavior and nonmanipulable battlefield outcomes. I present a model of simultaneous bargaining and fighting where both players can make offers and asymmetric information exists about the distribution of power. In the Markov perfect sequential equilibrium, making and rejecting offers has informational value that outweighs the one provided by the battlefield. However, states use both sources of information to learn and settle before military victory. The Principle of Convergence posits that warfare ceases to be useful when it loses its informational content and that belief in defeat (victory) is not necessary to terminate (initiate) hostilities. Thus, the standard puzzle in international relations that seeks to account for prewar optimism on both sides may not be that relevant.},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/2MZZFEAK/Slantchev_2003_The Principle of Convergence in Wartime Negotiations.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/C9VQDN34/Slantchev_2003_The Principle of Convergence in Wartime Negotiations.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/CMFQHR9W/Slantchev_2003_The Principle of Convergence in Wartime Negotiations.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/YHXAHG5T/Slantchev_2003_The Principle of Convergence in Wartime Negotiations.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/AV8IIWCY/7F3E14B2106771D14F74E6BBFE20945F.html}
