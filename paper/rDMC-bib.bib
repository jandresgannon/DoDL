@article{bas_mutualoptimismcause_2016,
  title = {Mutual {{Optimism}} as a {{Cause}} of {{Conflict}}: {{Secret Alliances}} and {{Conflict Onset}}},
  shorttitle = {Mutual {{Optimism}} as a {{Cause}} of {{Conflict}}},
  author = {Bas, Muhammet and Schub, Robert},
