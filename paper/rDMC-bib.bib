@article{lorenzoni_leveraginginterfirmrelationships_1999,
  title = {The Leveraging of Interfirm Relationships as a Distinctive Organizational Capability: A Longitudinal Study},
  shorttitle = {The Leveraging of Interfirm Relationships as a Distinctive Organizational Capability},
  author = {Lorenzoni, Gianni and Lipparini, Andrea},
