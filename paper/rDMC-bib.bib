}

@article{haughton_economicmeasurementdeterminants_1995,
  ids = {haughton_economicmeasurementdeterminants_1995a},
  title = {The Economic Measurement and Determinants of Diversity},
  author = {Haughton, Dominique M. A. and Mukerjee, Swati},
  year = {1995},
  month = nov,
  journal = {Social Indicators Research},
  volume = {36},
