@incollection{nacht_crossdomaindeterrenceamerican_2019,
  title = {Cross-{{Domain Deterrence}} in {{American Foreign Policy}}},
  booktitle = {Cross-{{Domain Deterrence}}},
  author = {Nacht, Michael and Schuster, Patricia and Uribe, Eva C.},
  editor = {Lindsay, Jon R. and Gartzke, Erik A.},
