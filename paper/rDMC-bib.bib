@article{narang_civilmilitarypathologiesdefeat_2017,
  ids = {narangCivilMilitaryPathologiesDefeat2017,narang_civilmilitarypathologiesdefeat_2018},
  title = {Civil-Military {{Pathologies}} and {{Defeat}} in {{War}}: {{Tests Using New Data}}},
  shorttitle = {Civil-Military {{Pathologies}} and {{Defeat}} in {{War}}},
  author = {Narang, Vipin and Talmadge, Caitlin},
