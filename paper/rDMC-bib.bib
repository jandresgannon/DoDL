  year = {2023},
  month = jun,
  number = {4490035},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4490035},
  urldate = {2024-05-08},
  abstract = {Two-way fixed effects (TWFE) models are widely used for causal panel analysis in political science. However, recent methodological literature questions their validity when faced with heterogeneous treatment effects (HTE) and violations of the parallel trends assumption (PTA). To assess the impact of these concerns, we reviewed, replicated, and reanalyzed 37 articles from three leading political science journals that utilized observational panel data with binary treatments. We implement six newly proposed HTE-robust estimators and find that, while they might affect precision, these estimators generally do not alter the substantive conclusions originally drawn from TWFE estimates. However, violations of the PTA and lack of sufficient statistical power persist as primary challenges to credible inference. Based on these findings, we offer recommendations for improving empirical practices in empirical research.},
  langid = {english},
  keywords = {difference-in-differences,done,heterogeneous treatment effects,panel data,parallel trends,pretrend,two-way fixed effects},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/73CIN66W/Chiu et al. - 2023 - What To Do (and Not to Do) with Causal Panel Analy.pdf}
}

