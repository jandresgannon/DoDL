@article{gulati_naturepartneringexperience_2009,
  title = {The Nature of Partnering Experience and the Gains from Alliances},
  author = {Gulati, Ranjay and Lavie, Dovev and Singh, Harbir},
  year = {2009},
  month = nov,
  journal = {Strategic Management Journal},
  volume = {30},
  number = {11},
  pages = {1213--1233},
  issn = {1097-0266},
  doi = {10.1002/smj.786},
  urldate = {2018-10-30},
  abstract = {We examine the conditions under which the prior partnering experience of firms contributes to value creation in their new alliances. We propose that prior experience with the same partners, that is, `partner-specific experience,' provides greater benefits than `general partnering experience' that encompasses all prior alliances with any partner. We further explore some of the boundary conditions for the effects of partner-specific experience. We suggest that the effect of partner-specific experience on value creation in alliances is moderated by the extent to which the assets of the new partner differ from those of the firm's prior partners. We also propose that the firm's own technological and financial resources increase the benefits of partner-specific experience. Finally, we predict that the value of partner-specific experience will increase under high levels of firm-specific uncertainty. We test these hypotheses with comprehensive longitudinal multi-industry data on joint ventures formed among Fortune 300 firms between 1987 and 1996. Based on stock market returns to joint venture announcements, the results provide support for the contingent value of partnering experience. The implications for managing alliances and advancing organizational learning are discussed. Copyright {\copyright} 2009 John Wiley \& Sons, Ltd.},
  copyright = {Copyright {\copyright} 2009 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {alliances,partnering experience,value creation},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/IUMFL5FU/Gulati et al_2009_The nature of partnering experience and the gains from alliances.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/CTZZTB5F/smj.html}
}

@article{gulati_networklocationlearning_1999,
  title = {Network Location and Learning: The Influence of Network Resources and Firm Capabilities on Alliance Formation},
  shorttitle = {Network Location and Learning},
  author = {Gulati, Ranjay},
  year = {1999},
  month = may,
  journal = {Strategic Management Journal},
  volume = {20},
  number = {5},
  pages = {397--420},
  issn = {1097-0266},
  doi = {10.1002/(SICI)1097-0266(199905)20:5<397::AID-SMJ35>3.0.CO;2-K},
  urldate = {2018-10-23},
  abstract = {This paper presents a dynamic, firm-level study of the role of network resources in determining alliance formation. Such resources inhere not so much within the firm but reside in the interfirm networks in which firms are placed. Data from extensive fieldwork show that by influencing the extent to which firms have access to information about potential partners, such resources are an important catalyst for new alliances, especially because alliances entail considerable hazards. This study also assesses the importance of firms' capabilities with alliance formation and material resources as determinants of their alliance decisions. I test this dynamic framework and its hypotheses about the role of time-varying network resources and firm capabilities with comprehensive longitudinal multi-industry data on the formation of strategic alliances by a panel of firms between 1970 and 1989. The results confirm field observations that accumulated network resources arising from firm participation in the network of accumulated prior alliances are influential in firms' decisions to enter into new alliances. This study highlights the importance of network resources that firms derive from their embeddedness in networks for explaining their strategic behavior. Copyright {\copyright} 1999 John Wiley \& Sons, Ltd.},
  copyright = {Copyright {\copyright} 1998 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {cooperative capabilities,done,embeddedness,organizational learning,social networks,strategic alliances},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3E7S3LY6/Gulati_1999_Network location and learning.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/IHKC8426/(SICI)1097-0266(199905)205397AID-SMJ353.0.html}
}

@article{gulati_renewalreorganizationvalue_2009,
  title = {Renewal {{Through Reorganization}}: {{The Value}} of {{Inconsistencies Between Formal}} and {{Informal Organization}}},
  shorttitle = {Renewal {{Through Reorganization}}},
  author = {Gulati, Ranjay and Puranam, Phanish},
  year = {2009},
  month = apr,
  journal = {Organization Science},
  volume = {20},
  number = {2},
  pages = {422--440},
  issn = {1047-7039},
  doi = {10.1287/orsc.1090.0421},
  urldate = {2018-10-30},
  abstract = {We develop a theoretical perspective on how inconsistencies between formal and informal organization arising from reorganization can help create ambidextrous organizations. We argue that under some conditions, the informal organization can compensate for the formal organization by motivating a distinct but valuable form of employee behavior that the formal organization does not emphasize, and vice versa---an effect we label compensatory fit. We illustrate the concept of compensatory fit by drawing on qualitative data from a reorganization at Cisco Systems. We also derive formal boundary conditions for compensatory fit using a simple game theoretic representation. We show that compensatory fit can only work when there is a powerful informal organization already in existence, and when the gains from ambidexterity are substantial. Further, depending on the strength of the informal organization, breakdown in the conditions necessary for compensatory fit may lead to performance declines and further reorganizations.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/9GDXGHYU/Gulati_Puranam_2009_Renewal Through Reorganization.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/P9LGPYAC/orsc.1090.html}
}

