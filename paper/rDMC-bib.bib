@article{jervis_securityregimes_1982,
  title = {Security Regimes},
  author = {Jervis, Robert},
  year = {1982},
  journal = {International Organization},
  volume = {36},
  number = {2},
  pages = {357--378},
  issn = {1531-5088, 0020-8183},
  doi = {10.1017/S0020818300018981},
  urldate = {2018-10-21},
  abstract = {Regimes are harder to establish in the security area than they are in the economic realm because of the inherently competitive cast of many security concerns, the unforgiving nature of the problems, and the difficulty in determining how much security the state has or needs. Nevertheless, there is at least one example of a functioning security regime---the Concert of Europe. Under the Concert the great powers sharply moderated their individualistic and competitive policies and exercised restraint in the expectation that others would reciprocate. The self-interest that they followed was broader and longer-run than usual. The Balance of Power, however, is a regime only if the restraints are internal, as Kaplan implies, as contrasted with Waltz's formulation in which states restrain each other. Current superpower relations should not be considered a regime because the principles, rules, and norms have little autonomy but instead can be best understood as quite direct reflections of the states' power and interests.},
