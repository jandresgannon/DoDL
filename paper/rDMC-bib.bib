  doi = {10.1080/03050628808434697},
  urldate = {2016-09-22},
  abstract = {An important approach to understanding power seeks a generalized measure that can rank nation-states from the most to the least powerful. Data-oriented researchers have developed several such single- and multivariable, linear and nonlinear indices. The test of their usefulness varies with their intended purpose. For policymakers desiring the most efficient way to assess the likelihood that a nation-state can achieve its goals, the key issues are parsimony in the selection of variables, stability over time, combinatorial patterns enabling successful prediction, and applicability across a range of situations. For theoreticians the index must ``work'' within the chosen theoretical context. If several indices meet the constraints imposed by the theory, then that one should be chosen that introduces the least amount of additonal (nontheoretical) information.},
