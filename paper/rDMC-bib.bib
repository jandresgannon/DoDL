  publisher = {The University of Chicago Press},
  issn = {0022-3808},
  doi = {10.1086/720458},
  urldate = {2023-03-06},
  abstract = {I study the overstatement of economic growth in autocracies by comparing self-reported GDP figures to night-time light recorded by satellites from outer space. I show that the night-time-light elasticity of GDP is larger in authoritarian regimes, even accounting for differences in multiple country characteristics. This autocracy gradient in the elasticity is greater when the incentive to exaggerate economic growth is stronger or when the constraints on exaggeration are weaker. The results suggest that autocracies overstate yearly GDP growth by approximately 35\%. Adjusting the data for manipulation leads to a more nuanced view on the recent economic success of autocracies.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/P2L8SHUA/Martínez_2022_How Much Should We Trust the Dictator’s GDP Growth Estimates.pdf}
