@article{bier_optimalresourceallocation_2008,
  title = {Optimal {{Resource Allocation}} for {{Defense}} of {{Targets Based}} on {{Differing Measures}} of {{Attractiveness}}},
  author = {Bier, Vicki M. and Haphuriwat, Naraphorn and Menoyo, Jaime and Zimmerman, Rae and Culpen, Alison M.},
  year = {2008},
  month = jun,
  journal = {Risk Analysis},
  volume = {28},
  number = {3},
  pages = {763--770},
  issn = {1539-6924},
  doi = {10.1111/j.1539-6924.2008.01053.x},
  urldate = {2018-01-09},
  abstract = {This article describes the results of applying a rigorous computational model to the problem of the optimal defensive resource allocation among potential terrorist targets. In particular, our study explores how the optimal budget allocation depends on the cost effectiveness of security investments, the defender's valuations of the various targets, and the extent of the defender's uncertainty about the attacker's target valuations. We use expected property damage, expected fatalities, and two metrics of critical infrastructure (airports and bridges) as our measures of target attractiveness. Our results show that the cost effectiveness of security investment has a large impact on the optimal budget allocation. Also, different measures of target attractiveness yield different optimal budget allocations, emphasizing the importance of developing more realistic terrorist objective functions for use in budget allocation decisions for homeland security.},
  langid = {english},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/P9T3QD3K/Bier et al_2008_Optimal Resource Allocation for Defense of Targets Based on Differing Measures.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/7YXNYYN3/abstract.html}
}

