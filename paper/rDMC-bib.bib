  journal = {Journal of Peace Research},
  volume = {53},
  number = {3},
  pages = {359--377},
  issn = {0022-3433, 1460-3578},
  doi = {10.1177/0022343316630037},
  urldate = {2016-05-11},
  abstract = {This article assesses the impact of a new form of defense cooperation -- formal weapons cooperation agreements, or WCAs -- on the global arms trade. WCAs are bilateral framework agreements that establish comprehensive guidelines on the development, production, and exchange of conventional arms. Substantively, WCAs regulate such core areas as procurement and contracting, defense-based research and development, and defense industrial cooperation. These agreements have proliferated dramatically since the mid-1990s. They now number nearly 700, with 30--40 new WCAs signed each year. Newly collected data are used to analyze the effect of WCAs on import and export of conventional weapons. To control for interdependencies in the formation of WCAs, and to account for the mutually endogenous relationship between WCAs and weapons flows, WCAs are modeled as an interdependent network that coevolves with the individual-level arms trade activity of states. The analysis shows that, over the 1995--2010 period, WCAs have significantly increased weapons flows.},
  langid = {english},
  keywords = {done,unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/A74L6A2L/Kinne_2016_Agreeing to arm Bilateral weapons agreements and the global arms trade.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/DFJRB2TA/Kinne_2016_Agreeing to arm Bilateral weapons agreements and the global arms trade.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/E3CG7TBK/Kinne_2016_Agreeing to arm Bilateral weapons agreements and the global arms trade.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/F87SKRBH/359.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/FXZ6439A/359.html}
