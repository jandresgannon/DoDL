  shorttitle = {A Mercenary Army of the Poor?},
  author = {Asoni, Andrea and Gilli, Andrea and Gilli, Mauro and Sanandaji, Tino},
  year = {2020},
  month = jan,
  journal = {Journal of Strategic Studies},
  volume = {0},
  number = {0},
  pages = {1--47},
  issn = {0140-2390},
  doi = {10.1080/01402390.2019.1692660},
  urldate = {2020-01-31},
  abstract = {We test two sets of alternative hypotheses about the demographic composition of the U.S. armed forces. We analyse individual-level data of two national representative samples covering the period 1979--2008. We find that, in contrast to the accepted wisdom, the U.S. military no longer primarily recruits individuals from the most disadvantaged socio-economic backgrounds. Technological, tactical, operational and doctrinal changes have led to a change in the demand for personnel. As a result, on different metrics such as family income and family wealth as well as cognitive abilities, military personnel are on average like the average American citizen or slightly better.},
  keywords = {nosource}
}

@techreport{asoni_richmanwar_2016,
  type = {{{SSRN Scholarly Paper}}},
  title = {Rich {{Man}}'s {{War}}, {{Poor Man}}'s {{Fight}}? {{Technological Change}}, {{Socio-Economic Inequality}} and the {{Demographic Composition}} of the {{American Military}}},
  shorttitle = {Rich {{Man}}'s {{War}}, {{Poor Man}}'s {{Fight}}?},
  author = {Asoni, Andrea and Gilli, Andrea and Gilli, Mauro and Sanandaji, Tino},
  year = {2016},
  month = feb,
  number = {ID 2728702},
  address = {Rochester, NY},
  institution = {Social Science Research Network},
  urldate = {2017-12-14},
  abstract = {What is the effect of technological change on the demographic composition of the U.S. military? Has growing socio-economic inequality influenced who joins the U.S. armed forces? In this article, we develop a new a theory of military recruitment that answers these questions. According to the existing consensus, the poor are more likely to enlist in US armed forces. We argue that this consensus is unwarranted. First, it is based on the assumption that the demand for personnel has remained constant over the past six decades. However, because of the transformation towards high-tech warfare that has characterized U.S. armed forces since the late 1970s, the military has become more selective. Accordingly, we expect those coming from disadvantaged segments of the American society to be screened out. Second, the empirical evidence supporting the conventional wisdom relies on aggregate data that do not permit to reach definitive conclusions about military personnel's socio-economic background. We test our theory on individual-level data. Consistently with our argument, we find that, in contrast to the past, those who join the U.S. military are not statistically different from the median household with regard to education, cognitive abilities, parental income and other socio-economic indicators.},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/MV7NCPY5/papers.html}
}

