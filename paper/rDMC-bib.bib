@incollection{millett_amphibiouswaramerican_1996,
  title = {Amphibious {{War}}, {{The American}}, {{British}}, and {{Japanese Cases}}},
  booktitle = {Military {{Innovation}} in the {{Interwar Period}}},
  author = {Millett, Allan R.},
