@article{geller_nuclearweaponsdeterrence_1990,
  title = {Nuclear {{Weapons}}, {{Deterrence}}, and {{Crisis Escalation}}},
  author = {Geller, Daniel S.},
  year = {1990},
  month = jun,
  journal = {Journal of Conflict Resolution},
  volume = {34},
  number = {2},
  pages = {291--310},
  issn = {0022-0027},
  doi = {10.1177/0022002790034002006},
  urldate = {2017-02-27},
  abstract = {The effect of the possession of nuclear weapons on patterns of international conflict is the subject of an extensive but generally impressionistic body of work. Assumptions in this area determine one's confidence in superpower deterrence and fuel the debate over the proper expenditure of military allocations. This study presents an analysis of escalation patterns in interstate disputes among nations with both identical and different levels of weapons technology. The results demonstrate that the distribution of nuclear capabilities does impact the patterns of escalation in serious international conflicts. The findings are supportive of the thesis of competitive risk taking in disputes between nuclear powers but also indicate that the possession of nuclear weapons has no apparent inhibitory effect on the escalatory propensities of nonnuclear opponents. The principal policy implication of this analysis is that nuclear weapons cannot be relied upon to impede escalatory dispute behavior by either nuclear or nonnuclear antagonists.},
  langid = {english},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/UXJ8RAJV/Geller_1990_Nuclear Weapons, Deterrence, and Crisis Escalation.pdf}
}

