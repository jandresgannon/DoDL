@article{alcock_perceptionnationalpower_1970,
  title = {The {{Perception}} of {{National Power}}},
  author = {Alcock, Norman Z. and Newcombe, Alan G.},
  year = {1970},
  journal = {Journal of Conflict Resolution},
  volume = {14},
  number = {3},
  eprint = {173513},
  eprinttype = {jstor},
  pages = {335--343},
  issn = {0022-0027},
  urldate = {2016-09-30},
  abstract = {The purpose of this empirical research is to define "national power" in quantitative terms. Thirty-eight Canadians were asked to rank 117 nations "in order of their power as they think of them." The average rank ordering was then regressed against three independent variables: Population, GNP/Capita, and Area/Capita. For confirmation, a similar regression analysis was done for a study of 20 Latin American countries ranked according to their "prestige or importance" (Schwartzman and Araujo). In both cases the two dominant terms were found to be Population and GNP/Capita; in fact, GNP alone proved to be a reliable indicator of power or prestige, unless some of the nations were recently at war, when military expenditure was a more accurate indicator. A quantitative measure of power is thought to have both theoretical and practical implications: in the study of international relations, and for devising weighted voting schemes at the United Nations.},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/J9RXP4SM/Alcock_Newcombe_1970_The Perception of National Power.pdf}
}

@article{aleta_multilayernetworksnutshell_2019,
  title = {Multilayer {{Networks}} in a {{Nutshell}}},
  author = {Aleta, Alberto and Moreno, Yamir},
  year = {2019},
  journal = {Annual Review of Condensed Matter Physics},
  volume = {10},
  number = {1},
  pages = {45--62},
  doi = {10.1146/annurev-conmatphys-031218-013259},
  urldate = {2020-04-22},
  abstract = {Complex systems are characterized by many interacting units that give rise to emergent behavior. A particularly advantageous way to study these systems is through the analysis of the networks that encode the interactions among the system constituents. During the past two decades, network science has provided many insights in natural, social, biological, and technological systems. However, real systems are often interconnected, with many interdependencies that are not properly captured by single-layer networks. To account for this source of complexity, a more general framework, in which different networks evolve or interact with each other, is needed. These are known as multilayer networks. Here, we provide an overview of the basic methodology used to describe multilayer systems as well as of some representative dynamical processes that take place on top of them. We round off the review with a summary of several applications in diverse fields of science.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/6E6P8H8K/Aleta_Moreno_2019_Multilayer Networks in a Nutshell.pdf}
}

