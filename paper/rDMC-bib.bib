@article{kearney_modellingecologicalniche_2010,
  title = {Modelling the Ecological Niche from Functional Traits},
  author = {Kearney, Michael and Simpson, Stephen J. and Raubenheimer, David and Helmuth, Brian},
  year = {2010},
  month = nov,
  journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  volume = {365},
  number = {1557},
  pages = {3469--3483},
  publisher = {Royal Society},
  doi = {10.1098/rstb.2010.0034},
  urldate = {2024-11-12},
  abstract = {The niche concept is central to ecology but is often depicted descriptively through observing associations between organisms and habitats. Here, we argue for the importance of mechanistically modelling niches based on functional traits of organisms and explore the possibilities for achieving this through the integration of three theoretical frameworks: biophysical ecology (BE), the geometric framework for nutrition (GF) and dynamic energy budget (DEB) models. These three frameworks are fundamentally based on the conservation laws of thermodynamics, describing energy and mass balance at the level of the individual and capturing the prodigious predictive power of the concepts of `homeostasis' and `evolutionary fitness'. BE and the GF provide mechanistic multi-dimensional depictions of climatic and nutritional niches, respectively, providing a foundation for linking organismal traits (morphology, physiology, behaviour) with habitat characteristics. In turn, they provide driving inputs and cost functions for mass/energy allocation within the individual as determined by DEB models. We show how integration of the three frameworks permits calculation of activity constraints, vital rates (survival, development, growth, reproduction) and ultimately population growth rates and species distributions. When integrated with contemporary niche theory, functional trait niche models hold great promise for tackling major questions in ecology and evolutionary biology.},
  keywords = {biophysical ecology,climatic niche,dynamic energy budget,functional traits,geometric framework,nutritional niche},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/KV2FY9JI/Kearney et al. - 2010 - Modelling the ecological niche from functional traits.pdf}
}

