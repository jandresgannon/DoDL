  month = nov,
  journal = {International Theory},
  volume = {5},
  number = {3},
  pages = {414--445},
  issn = {1752-9719, 1752-9727},
  doi = {10.1017/S1752971913000250},
  urldate = {2016-10-06},
  abstract = {How does the scope of costless threats convey information about resolve to adversaries? Analysis of a model similar to Fearon demonstrates that higher demands increase perceptions of a state's resolve to fight for more favorable outcomes when bargaining is such that both sides share in the benefits of avoiding conflict, in contrast to the ultimatum game, and making a credible high demand does not lead to a favorable outcome with certainty. Interestingly, compromise offers will be made even though they increase an adversary's perception that the compromising state would be willing to make an even greater concession. In contrast to many other signaling mechanisms described in the literature, signaling of this sort does not depend on risking war and often reduces the probability of conflict.},
  keywords = {done},
