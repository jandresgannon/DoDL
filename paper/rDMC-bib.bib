@article{epstein_whenlegaciesmeet_2006,
  title = {When {{Legacies Meet Policies}}: {{NATO}} and the {{Refashioning}} of {{Polish Military Tradition}}},
  shorttitle = {When {{Legacies Meet Policies}}},
