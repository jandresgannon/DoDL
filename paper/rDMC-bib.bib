@article{oneal_budgetarysavingsconscription_1992,
  title = {Budgetary Savings from Conscription and Burden Sharing in {{NATO}}},
  author = {Oneal, John R.},
  year = {1992},
  month = apr,
  journal = {Defence Economics},
  volume = {3},
