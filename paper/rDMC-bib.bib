  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/6XZZ4BPM/Chiu_2003_International Alliances in the Power Cycle Theory of State Behavior.pdf}
}

@misc{chiu_whatnotcausal_2023,
  type = {{{SSRN Scholarly Paper}}},
  title = {What {{To Do}} (and {{Not}} to {{Do}}) with {{Causal Panel Analysis}} under {{Parallel Trends}}: {{Lessons}} from {{A Large Reanalysis Study}}},
