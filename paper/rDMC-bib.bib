@article{droff_whenmilitaryinterventions_2023,
  ids = {droff_whenmilitaryinterventions_2023a},
  title = {When {{Military Interventions Decrease Military Power Evidence}} from the {{French Case}}},
  author = {Droff, Josselin and Malizard, Julien and Schmitt, Olivier},
