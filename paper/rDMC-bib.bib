  urldate = {2016-05-17},
  abstract = {Neoinstitutionalists applying the logic of rational choice institutionalism have leavened our understanding of public agency design and evolution in the domestic and national security policy domains. This paper seeks to advance theory building in empirically grounded ways by assessing the explanatory power of an important theoretical perspective (rational choice institutionalism), in an understudied ``hybrid'' policy domain where domestic and national security aims interact (domestic environmental policy and national security policy), and in an organizational type (the U.S. military) that has drawn scant attention from students of bureaucracy in political science, public administration, or public management. Analysis of three major efforts to green the U.S. military suggests that the patterns of politics accompanying agency evolution involving hybrid policy domains differ from domestic and national security domains in ways that limit the generalizability of rational choice institutionalism.},
