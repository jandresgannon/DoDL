  doi = {10.1002/(SICI)1097-0266(199910)20:10<969::AID-SMJ57>3.0.CO;2-0},
  urldate = {2018-10-16},
  abstract = {This research note investigates the trend towards specializing the Herfindahl index H for measuring industry concentration and the entropy measure E for expressing firm diversity. Examining the ``decomposability'' of E and H, we show that the professed overriding advantage of the entropy measure with respect to decomposability is not its exclusive preserve; the paper contains a proof that this property is also shared by the Herfindahl index. It is also shown that, due to its more stable range, the H index is more versatile with respect to inversion than the E measure. Strategy researchers are thereby cautioned that the current trend toward an increased use of entropy is risky and should be reassessed. Copyright {\copyright} 1999 John Wiley \& Sons, Ltd.},
  copyright = {Copyright {\copyright} 1999 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {diversity measures,done,entropy,Herfindahl,Herfindahl decomposition,specializing measures},
