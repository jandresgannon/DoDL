@article{ortiz-villajos_militarytechnologydefense_2023,
  title = {Military {{Technology}}, {{Defense Spending}} and {{Modernization}} of the {{Armed Forces}}: {{The Case}} of {{Spain}}, 1891-1935},
  shorttitle = {Military {{Technology}}, {{Defense Spending}} and {{Modernization}} of the {{Armed Forces}}},
  author = {{Ortiz-Villajos}, Jos{\'e} M. and {Martos-G{\'o}mez}, Jos{\'e} J.},
