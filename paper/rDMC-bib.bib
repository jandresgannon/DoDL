  abstract = {Through its ``open--door'' policy, NATO continues to promote membership expansion. Among the aspiring candidates, Albania has campaigned aggressively for membership in the alliance. In accordancce with NATO's recent mission changes and adaptations, our research examines Albania's military reforms across three measures, including its efforts to modernize its armed forces, the status of its military capabilities, and its recent steps to combat global terrorism. While we find that Albania suffers on all three of these standards, our research indicates that Albania has responded to NATO's calls for change and that NATO has been an important catalyst for encouraging military reform.},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8PF3HY54/Hendrickson et al_2006_Albania and NATO's “Open Door” Policy.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/FF2S4VCD/Hendrickson et al_2006_Albania and NATO's “Open Door” Policy.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/GXYWVHZ5/13518040600697779.html}
