  keywords = {Social Science / Anthropology / General,Social Science / Regional Studies,Social Science / Sociology / General}
}

@article{rostoks_natosreassurancewillingness_,
  title = {{{NATO}}'s Reassurance and the Willingness to Defend One's Country: Survey Evidence from {{Latvia}}},
  shorttitle = {{{NATO}}'s Reassurance and the Willingness to Defend One's Country},
  author = {Rostoks, Toms and Mieri{\c n}a, Inta},
  journal = {European Security},
  volume = {0},
  number = {0},
  pages = {1--21},
  publisher = {Routledge},
  issn = {0966-2839},
  doi = {10.1080/09662839.2024.2434087},
  urldate = {2025-01-06},
  abstract = {Russia's full-scale invasion of Ukraine in 2022 brings into question the significance of people's willingness to defend their respective countries. While there have been many studies of various domestic-level factors that affect the willingness to defend one's country, we explore the willingness to fight and defend in the NATO context. We claim that in cases of extreme military asymmetry, citizens' willingness to defend their country depends largely on the extent to which they feel reassured by allies that military assistance will be provided in the case of armed aggression. Our study demonstrates this relationship by focusing on the case of Russia and Latvia. Using recent surveys from Latvia, we show that confidence in NATO security guarantees strongly boosts a society's willingness to defend its country, both individually and at the national level. We conclude that while NATO deterrent effects vis-{\`a}-vis Russia remain uncertain, the effects with respect to reassuring the Latvian population are very important. Our study also points to several other crucial factors that affect citizens' willingness to defend their country, such as confidence in the military and the government, views on an opponent's military dominance, as well as patriotism and a strong sense of belonging to the country.},
  keywords = {extended deterrence,Latvia,military tripwires,NATO,reassurance,Willingness to defend},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/LBGF8295/Rostoks and Mieriņa - NATO's reassurance and the willingness to defend one’s country survey evidence from Latvia.pdf}
}

