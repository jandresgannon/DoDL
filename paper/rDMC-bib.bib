  author = {White, Steven and Lui, Steven Siu-Yun},
  year = {2005},
  month = oct,
  journal = {Strategic Management Journal},
  volume = {26},
  number = {10},
  pages = {913--932},
  issn = {1097-0266},
  doi = {10.1002/smj.490},
  urldate = {2018-10-23},
  abstract = {Firms simultaneously face the need to cooperate with and control an alliance partner. To complement the transaction cost perspective's emphasis on the need to control and limit opportunistic behavior, we examine the sources and impact of the cooperation costs incurred in order to work with a partner. We propose that these costs increase with greater joint task complexity and interpartner diversity, and perceptions of equitable behavior affect the perceptions of these costs. Hypotheses derived from the framework are tested in a sample of 231 contractual alliances between architects and general contractors in the Hong Kong construction industry. We find that both cooperation costs and transaction costs affect the level of time and effort a manager expends on an alliance, supporting our fundamental proposition that the costs of cooperation and control are conceptually and empirically distinct. We argue that cooperation costs should be incorporated into studies that compare the choice of alternative partners and alliance structures, as well as among the broader categories of market, hierarchy, and hybrid governance forms. Copyright {\copyright} 2005 John Wiley \& Sons, Ltd.},
  copyright = {Copyright {\copyright} 2005 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {alliances,comparative governance,cooperation,coordination costs,transaction costs},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/R5EX8YV5/White_Lui_2005_Distinguishing costs of cooperation and control in alliances.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/G8NL79VL/smj.html}
}

