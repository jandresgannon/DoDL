@article{mehrl_interwarperiodinternational_2024,
  title = {The {{Interwar Period International Trade}} in {{Arms}}: {{A New Dataset}}},
  shorttitle = {The {{Interwar Period International Trade}} in {{Arms}}},
  author = {Mehrl, Marius and Thurner, Paul W.},
