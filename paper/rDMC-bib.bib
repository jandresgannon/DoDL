  title = {Dispersion Indices Based on {{Kerridge}} Inaccuracy Measure and {{Kullback-Leibler}} Divergence},
  author = {Balakrishnan, Narayanaswamy and Buono, Francesco and Cal{\`i}, Camilla and Longobardi, Maria},
  year = {2023},
  month = jun,
