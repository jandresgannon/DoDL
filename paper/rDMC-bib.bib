@article{gannon_keepingyourfriends_2021,
  ids = {gannonKeepingYourFriends2020},
  title = {Keeping {{Your Friends Close}}, but {{Acquaintances Closer}}: {{Why Weakly Allied States Make Committed Coalition Partners}}},
