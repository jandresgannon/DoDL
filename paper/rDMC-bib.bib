@techreport{johnson_alliancecharacteristicsextended_2012,
  type = {{{SSRN Scholarly Paper}}},
  title = {Alliance {{Characteristics}} and {{Extended General Deterrence}}},
  author = {Johnson, Jesse C. and Leeds, Brett Ashley and Wu, Ahra},
  year = {2012},
  number = {ID 2107207},
  address = {Rochester, NY},
  institution = {Social Science Research Network},
  urldate = {2018-01-15},
  abstract = {Deterrence theory suggests that extended general deterrent threats are likely to be more effective when a potential challenger views them as capable and credible.  When states sign formal defense pacts, they are making explicit extended general deterrent threats. Thus, the population of defense pacts allows us an opportunity to judge the efficacy of extended deterrent threats with different characteristics. We evaluate whether factors that increase the capabilities of an alliance, such as peacetime military coordination or having strong members, increase the ability of alliances to deter potential challengers. We also evaluate whether factors that increase the credibility of an alliance, such as a more formalized alliance or having members with similar policy positions, increase the ability of alliances to deter potential challengers. We find that both institutional design and ally characteristics affect general deterrence success. This analysis provides support for deterrence theory in the context of extended general deterrence.  It also provides evidence that should aid policymakers in designing security structures to meet their goals.},
  langid = {english},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/KED2A3BB/papers.html}
}

@article{johnson_alliancereliabilitydispute_2023,
  title = {Alliance {{Reliability}} and {{Dispute Escalation}}},
  author = {Johnson, Jesse C. and Wolford, Scott},
  year = {2023},
  journal = {Journal of Conflict Resolution},
  volume = {67},
  number = {4},
  pages = {617--641},
  publisher = {SAGE Publications Inc},
  issn = {0022-0027},
  doi = {10.1177/00220027221121140},
  urldate = {2022-08-31},
  abstract = {States form defensive alliances hoping to deter adversaries and avoid war. However, scholars and policy analysts often worry that if an alliance fails to deter the promise of military support will encourage escalation, pushing disputants closer to war. We show that in many cases this concern is unwarranted. We use a game-theoretic model of alliance reliability and crisis bargaining to show that the same factors that indicate unreliability and provoke disputes also encourage alliance members to make concessions rather than risk war. We test this hypothesis using a sample of militarized disputes initiated against members of defensive alliances, where recent shifts in military capabilities represent changes in challengers' estimates of alliance reliability. Less-reliable alliances are less likely than reliable allies to deter disputes, but they also decrease the probability of escalation relative to reliable alliances. Unreliable alliances need not encourage war; rather, they can discourage it.},
  langid = {english},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ZBM3LWJK/johnson-wolford-2022-alliance-reliability-and-dispute-escalation.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/ZJ8S6F3B/Johnson and Wolford - 2023 - Alliance Reliability and Dispute Escalation.pdf}
}

@article{johnson_alliancetreatyobligations_2016,
  title = {Alliance Treaty Obligations and War Intervention},
  author = {Johnson, Jesse C.},
