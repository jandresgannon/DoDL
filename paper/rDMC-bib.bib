@article{joppa_reciprocalspecializationecological_2009,
  title = {Reciprocal Specialization in Ecological Networks},
  author = {Joppa, Lucas N. and Bascompte, Jordi and Montoya, Jose M. and Sol{\'e}, Ricard V. and Sanderson, Jim and Pimm, Stuart L.},
