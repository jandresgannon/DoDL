  author = {Croft, Stuart},
  year = {1989},
  month = oct,
  journal = {Futures},
  volume = {21},
  number = {5},
  pages = {466--479},
  issn = {0016-3287},
  doi = {10.1016/0016-3287(89)90086-4},
  urldate = {2017-11-15},
  abstract = {A key notion in the military relationship between the superpowers is stability. Yet improvements in national military capabilities brought about by technological innovation may damage stability and one of the most important means of achieving stability: arms control. The interaction of the superpowers' efforts to gain unilateral advantage may produce a stable relationship between them, but without cooperation such an outcome would be entirely fortuitous. This article argues that one of the most significant problems facing international security is not the emergence of new military technology, but rather the unmanaged nature of technological change. The article calls for the management of technological change in the military sphere in order to maintain stability, and suggests that some technological developments would be better constrained than developed.},
