@article{deni_natorapiddeployment_2004,
  title = {The {{NATO Rapid Deployment Corps}}: Alliance Doctrine and Force Structure},
  shorttitle = {The {{NATO Rapid Deployment Corps}}},
  author = {Deni, John R.},
  year = {2004},
  month = dec,
  journal = {Contemporary Security Policy},
  volume = {25},
  number = {3},
  pages = {498--523},
  issn = {1352-3260},
  doi = {10.1080/1352326042000330628},
  urldate = {2018-07-16},
  abstract = {Why did it take NATO until 2002 to implement many of the force structure changes its grand strategy called for in 1991? And once it did make the changes, why did they differ from what the alliance said it needed? The story of how the `most successful alliance in history' stumbled its way to what are today known as the NATO Rapid Deployment Corps (NRDCs) provides valuable lessons in understanding how the alliance plans and manages change while shedding light on the ongoing academic debate over the sources of military doctrine and force structure. Commonly employed models for explaining doctrine and force structure outcomes - threat-based models, organizational behaviour models and bureaucratic politics models - cannot independently explain this case. Rather, a combination of models provides the most explanatory power. Threat-based models explain the initiation of a doctrine and force structure review, but then organizational and bureaucratic models best explain NATO's doctrinal and force structure process and outcomes. By utilizing a combination of models, we can better understand how and why NATO changed its doctrine and force structure in the first decade of the twenty-first century. We can also contemplate NATO's ability and willingness to respond to future watershed changes in international security such as the fight against terrorism.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/YYNL9M9F/Deni_2004_The NATO Rapid Deployment Corps.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/BMTMA2YF/1352326042000330628.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/LX6SRDCE/1352326042000330628.html}
}

