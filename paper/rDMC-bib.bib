@article{diehl_armsracesescalation_1983,
  title = {Arms {{Races}} and {{Escalation}}: {{A Closer Look}}},
  shorttitle = {Arms {{Races}} and {{Escalation}}},
  author = {Diehl, Paul F.},
  year = {1983},
