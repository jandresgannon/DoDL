  title = {Ordered {{Beta Regression}}: {{A Parsimonious}}, {{Well-Fitting Model}} for {{Continuous Data}} with {{Lower}} and {{Upper Bounds}}},
  shorttitle = {Ordered {{Beta Regression}}},
  author = {Kubinec, Robert},
