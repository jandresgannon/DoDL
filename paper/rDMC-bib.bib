@article{gartzke_democracypreparationwar_2001,
  title = {Democracy and the {{Preparation}} for {{War}}: {{Does Regime Type Affect States}}' {{Anticipation}} of {{Casualties}}?},
  shorttitle = {Democracy and the {{Preparation}} for {{War}}},
  author = {Gartzke, Erik A.},
  year = {2001},
  journal = {International Studies Quarterly},
  volume = {45},
  number = {3},
  pages = {467--484},
  issn = {1468-2478},
  doi = {10.1111/0020-8833.00210},
  urldate = {2018-06-14},
  abstract = {Immanuel Kant and more recent expositors of the democratic peace thesis suggest that citizens in a republic sanction leaders for resorting to war because, in part, citizens are loath to shed their own blood. This Kantian thesis in turn implies substitution. Just as consumers confronted with price shocks shift consumption to less affected goods rather than simply curtailing consumption, democratic leaders facing retribution for casualties can limit losses, not just by avoiding military contests, but also by substituting capital (ships, tanks, aircraft) for labor (soldiers, sailors, airmen) in the provision of security. A simple consumer choice model shows that citizens' leverage over leaders implies that democracies should consume disproportionately more capital in preparing for---and conducting---defense. Numerous anecdotes assert that democracies do shelter labor with capital, especially during war, but tests of defense-factor allocations on factor endowments, regime-type, and other variables show that defense-factor usage is explained by basic economic theory and not by democracy.},
  copyright = {International Studies Association 2001},
  langid = {english},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3XKZPKKI/Gartzke_2001_Democracy and the Preparation for War.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/S7NQX5WP/Gartzke_2001_Democracy and the Preparation for War.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/3LSZ4UCM/0020-8833.html}
}

@article{gartzke_determinantsnuclearforce_2014,
  title = {The {{Determinants}} of {{Nuclear Force Structure}}},
  author = {Gartzke, Erik A. and Kaplow, Jeffrey M. and Mehta, Rupal N.},
  year = {2014},
  month = apr,
  journal = {Journal of Conflict Resolution},
  volume = {58},
  number = {3},
  pages = {481--508},
  issn = {0022-0027, 1552-8766},
  doi = {10.1177/0022002713509054},
  urldate = {2015-08-24},
  abstract = {A substantial literature examines the causes of nuclear proliferation, but few studies have addressed why states decide on a particular portfolio of weapon systems once they have acquired a basic nuclear capability. We advance a portfolio theory of nuclear force structure, positing that states seek a diverse set of capabilities for nuclear deterrence, but that they also face major resource and organizational constraints. A number of factors may help to explain the portfolio of nuclear forces that states ultimately field, including resource availability, experience as a nuclear power, bureaucratic politics, the conventional threat environment, the presence of nuclear rivals, and the maintenance of nuclear alliances. We test the influence of these factors on force structure using a new data set of nuclear weapon platforms fielded by nine nuclear nations between 1950 and 2000. Our findings represent an important step in understanding the drivers of nuclear behavior after states have joined the nuclear weapons club.},
  langid = {english},
  keywords = {done,unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/FJIGAJM8/Gartzke et al_2014_The Determinants of Nuclear Force Structure.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/JDDBJMFD/481.html}
}

