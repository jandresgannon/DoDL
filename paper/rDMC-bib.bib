@article{uzonyi_capturefortexplaining_2023,
  title = {Capture the {{Fort}}: {{Explaining}} the {{Timing}} of {{Rebel Assaults}} on {{Cities During Wartime}}},
  shorttitle = {Capture the {{Fort}}},
  author = {Uzonyi, Gary and Reeder, Bryce W.},
