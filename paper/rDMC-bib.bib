@article{mawdsley_armamentsdecisionmakingare_2018,
  title = {Armaments Decision-Making: {{Are European}} States Really Different?},
  shorttitle = {Armaments Decision-Making},
  author = {Mawdsley, Jocelyn},
  year = {2018},
