@article{doran_warcyclerelative_1980,
  title = {War and the {{Cycle}} of {{Relative Power}}},
  author = {Doran, Charles F. and Parsons, Wes},
  year = {1980},
  month = dec,
  journal = {American Political Science Review},
  volume = {74},
  number = {4},
  pages = {947--965},
  issn = {0003-0554, 1537-5943},
  doi = {10.2307/1954315},
  urldate = {2016-09-22},
  abstract = {Relative nation-state capability follows a generalized nonlinear pattern over long periods. Empirical evidence indicates that between 1816--1975 nine major powers have traversed at least a segment of this relative capability cycle of political ascendancy, maturation and decline. Specific changes in a state's relative capability dynamics increase its propensity to initiate extensive war. Whether the extensiveness of a war is defined in terms of duration, intensity or magnitude, major powers are likely to initiate more extensive wars at the critical inflection and turning points on the curve of relative capability where the linear role perceptions held by government and society change pervasively. This analysis involves a new theoretical focus for examining the causes of war, shifting attention from interactions between nations to the consequences of changes in relative power and to the political evolution of the nation-state itself.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/GCZNIE6H/Doran_Parsons_1980_War and the Cycle of Relative Power.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/V38T8XJW/Doran_Parsons_1980_War and the Cycle of Relative Power.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/IIQM75M9/4C08D6487E2C0EB4886B0EAB1DA0CF3E.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/V25UGWWM/4C08D6487E2C0EB4886B0EAB1DA0CF3E.html}
}

@article{doran_whyforecastsfail_1999,
  title = {Why {{Forecasts Fail}}: {{The Limits}} and {{Potential}} of {{Forecasting}} in {{International Relations}} and {{Economics}}},
  shorttitle = {Why {{Forecasts Fail}}},
  author = {Doran, Charles F.},
  year = {1999},
  month = jan,
  journal = {International Studies Review},
  volume = {1},
  number = {2},
  pages = {11--41},
  issn = {1468-2486},
  doi = {10.1111/1521-9488.00154},
  urldate = {2016-09-22},
  abstract = {A forecast is a prediction based on knowledge of past behavior. The forecaster must consider to what extent past trends will continue in the future. In linear forecasts, the past is prologue, and forecasting amounts to linear extrapolation of the past trend into the future. When conditions are propitious and behavior over time is approximately linear, the linear forecast will fit the data tolerably well. But forecasts ultimately fail because no technique has been developed that allows the forecaster to predict, prior to the event itself, when a nonlinearity will occur. This essay argues that a nonlinearity is a critical point at which expectations (predictions) induced by the prior trend suddenly confront a profound alteration in that trend, indeed, an abrupt inversion. A nonlinearity is a total break from the past trend, a discontinuity. The theory of relative power (systemic structure) dynamics known as power cycle theory provides both a thorough, graphic explanation of this discontinuity in expectations that occurs at critical points in the process, and the reason why nonlinearities are impossible to derive from prior trends. Theoretical and empirical assessment of a process and its dynamics makes possible an explanation of the conditions that give rise to such nonlinearity. Hence such dynamical analysis can predict that such a nonlinearity will occur, but in all but a closed system it still cannot predict when the nonlinearity will occur.},
  langid = {english},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/CC7NTTN9/Doran_1999_Why Forecasts Fail.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/KIAUJ88P/abstract.html}
}

@article{dorazio_crowdsourcingmeasurementinterstate_2016,
  title = {Crowdsourcing the {{Measurement}} of {{Interstate Conflict}}},
  author = {D'Orazio, Vito and Kenwick, Michael and Lane, Matthew and Palmer, Glenn and Reitter, David},
  year = {2016},
  month = jun,
  journal = {PLOS ONE},
  volume = {11},
  number = {6},
  pages = {e0156527},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0156527},
  urldate = {2016-11-02},
  abstract = {Much of the data used to measure conflict is extracted from news reports. This is typically accomplished using either expert coders to quantify the relevant information or machine coders to automatically extract data from documents. Although expert coding is costly, it produces quality data. Machine coding is fast and inexpensive, but the data are noisy. To diminish the severity of this tradeoff, we introduce a method for analyzing news documents that uses crowdsourcing, supplemented with computational approaches. The new method is tested on documents about Militarized Interstate Disputes, and its accuracy ranges between about 68 and 76 percent. This is shown to be a considerable improvement over automated coding, and to cost less and be much faster than expert coding.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/IQA6DNQA/D’Orazio et al_2016_Crowdsourcing the Measurement of Interstate Conflict.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/2W9ZVZ22/article.html}
