@article{downs_goodnewscompliance_1996,
  title = {Is the Good News about Compliance Good News about Cooperation?},
  author = {Downs, George W. and Rocke, David M. and Barsoom, Peter N.},
  year = {1996},
  month = jul,
  journal = {International Organization},
  volume = {50},
