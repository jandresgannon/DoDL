@article{oneal_theorycollectiveaction_1990,
  title = {The Theory of Collective Action and Burden Sharing in {{NATO}}},
  author = {Oneal, John R.},
  year = {1990},
  journal = {International Organization},
  volume = {44},
  number = {3},
  pages = {379--402},
  issn = {1531-5088, 0020-8183},
  doi = {10.1017/S0020818300035335},
  urldate = {2018-01-19},
  abstract = {Mancur Olson's theory of collective action could account for much of the variance in the defense burdens of the allied nations of the North Atlantic Treaty Organization (NATO) in the early years of the Cold War, but the association between economic size (gross domestic product, or GDP) and defense burden (the ratio of military expenditures to GDP) has declined to insignificant levels. Two influences are shown to be important in producing this change: the increased pursuit of private goods by Greece, Turkey, and Portugal and the growing cooperation among the other European allies. Since cooperation in the military realm has not provided the Europeans with credible means of self-defense, it appears to be a consequence of the general growth of interdependence in Europe during the postwar period. NATO is still essentially a uniquely privileged group producing a relatively pure public good. Accordingly, the theory of collective action continues to provide valuable insights into the operation of the alliance.},
  langid = {english},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/FTU4FTQF/Oneal_1990_The theory of collective action and burden sharing in NATO.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/Z9LMNTF6/90805EE05D1CD9E9859D155809F04E7F.html}
}

@article{oneal_theorycollectiveaction_1994,
  title = {The {{Theory}} of {{Collective Action}} and {{NATO Defense Burdens}}: {{New Empirical Tests}}},
  shorttitle = {The {{Theory}} of {{Collective Action}} and {{NATO Defense Burdens}}},
  author = {Oneal, John R. and Diehl, Paul F.},
  year = {1994},
  month = jun,
  journal = {Political Research Quarterly},
  volume = {47},
  number = {2},
  pages = {373--396},
  issn = {1065-9129},
  doi = {10.1177/106591299404700208},
  urldate = {2018-01-11},
  abstract = {Burden sharing has been a contentious topic from the early years of the North Atlantic alliance. Since 1966, it has also been a recurring test of the theory of collective action. Here we report the results of new tests of Mancur Olson's theory and its extension, the joint-product model, proposed by Todd Sandler et al. Our analyses of pooled cross-sectional and time-series data for fifteen NATO allies, 1950-86, offers the first full, independent test of the joint-product model. While our analyses demonstrate the theoretical value of Sandler's model, they also indicate that Olson's original emphasis on the public nature of the good supplied by the alliance remains valid. Some evidence regarding the role of the United States suggests that NATO has been a uniquely privileged group.},
  langid = {english},
  keywords = {unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/56NTT5MN/Oneal_Diehl_1994_The Theory of Collective Action and NATO Defense Burdens.pdf}
}

@article{oneil_australiafiveeyes_2017,
  title = {Australia and the `{{Five Eyes}}' Intelligence Network: The Perils of an Asymmetric Alliance},
  shorttitle = {Australia and the `{{Five Eyes}}' Intelligence Network},
  author = {O'Neil, Andrew},
  year = {2017},
  month = sep,
  journal = {Australian Journal of International Affairs},
  volume = {71},
  number = {5},
  pages = {529--543},
  issn = {1035-7718},
  doi = {10.1080/10357718.2017.1342763},
  urldate = {2018-03-16},
  abstract = {Aside from NATO, the Five Eyes intelligence network between the USA, the UK, Canada, Australia and New Zealand is the world's most enduring multilateral arrangement of its type. While the Five Eyes network does not constitute a formal security alliance in the classic sense of the term, it does emulate significant features of how alliances operate in practice, including active burden-sharing and intra-alliance bargaining. Most analysts claim that the USA dictates in hierarchical fashion the terms and conditions of how the Five Eyes network functions, and that junior partners have little alternative but to fall in line if they want to preserve the flow of high-grade intelligence from Washington. Using Australia as a case study, this article shows that a more fluid relationship has been at play, one that challenges conventional assumptions about asymmetrical alliances and the role of junior partners.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/NDPXAD8M/O’Neil_2017_Australia and the ‘Five Eyes’ intelligence network.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/GYLCWIIZ/10357718.2017.html}
}

