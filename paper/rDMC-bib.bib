@book{waltz_theoryinternationalpolitics_1979,
  title = {Theory of {{International Politics}}},
  author = {Waltz, Kenneth},
  year = {1979},
  publisher = {Waveland Press},
  address = {Reading, MA},
  abstract = {From Theory of International Politics . . . National politics is the realm of authority, of administration, and of law. International politics is the realm of power, of struggle, and of accommodation. . . . States, like people, are insecure in proportion to the extent of their freedom. If freedom is wanted, insecurity must be accepted. Organizations that establish relations of authority and control may increase security as they decrease freedom. If might does not make right, whether among people or states, then some institution or agency has intervened to lift them out of natures realm. The more influential the agency, the stronger the desire to control it becomes. In contrast, units in an anarchic order act for their own sakes and not for the sake of preserving an organization and furthering their fortunes within it. Force is used for ones own interest. In the absence of organization, people or states are free to leave one another alone. Even when they do not do so, they are better able, in the absence of the politics of the organization, to concentrate on the politics of the problem and to aim for a minimum agreement that will permit their separate existence rather than a maximum agreement for the sake of maintaining unity. If might decides, then bloody struggles over right can more easily be avoided.},
  googlebooks = {OaMfAAAAQBAJ},
  isbn = {978-1-4786-1053-3},
  langid = {english},
  keywords = {done},
