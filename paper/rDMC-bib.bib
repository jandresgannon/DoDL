  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/69ZIFQZW/Kinne_2013_Network Dynamics and the Evolution of International Cooperation.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8LWB6FPR/Kinne_2013_Network Dynamics and the Evolution of International Cooperation.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/9SBSEIM7/E686C749732F836F21371BD99061331B.html;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/HVPDEXAB/displayAbstract.html}
}

