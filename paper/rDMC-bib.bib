@article{tomashevskiy_friendspartnersestimating_2024a,
  title = {Friends and Partners: {{Estimating}} Latent Affinity Networks with the Graphical {{LASSO}}},
  shorttitle = {Friends and Partners},
  author = {Tomashevskiy, Andrey},
  year = {2024},
