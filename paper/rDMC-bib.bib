@inproceedings{cappellazielinski_dictatorsfightingtogether_2018,
  title = {Dictators {{Fighting Together}}: {{Exploring}} the {{Battlefield Performance}} of {{Nondemocratic Coalitions During}} the {{World Wars}}},
  booktitle = {American {{Political Science Association}} ({{APSA}}) Annual Conference},
  author = {Cappella Zielinski, Rosella and Grauer, Ryan and Poast, Paul},
  year = {2018},
  month = aug,
  address = {Boston, MA},
  abstract = {Democracies win the wars they fight. One mechanism thought to drive this ``democratic advantage'' in war is that democracies tend to fight as coalitions. Yet, by making use of new data on battlefield performance during the World Wars---the Allied in Combat dataset---we find that nondemocracies also experience a coalitional advantage, winning more battles together than apart. We probe this finding and argue that fighting as a coalition compels nondemocratic co-belligerents to adopt practices common to democratic militaries that fight together. More precisely, we argue that fighting in a coalition compels coordination that in turn facilitates resource concentration on the battlefield, allowing manpower and materiel to be amassed at key points on the battlefield without creating vulnerabilities elsewhere. Combined warfighting also allows partner militaries to carry out the battlefield tasks best suited to their doctrine and training. To assess the validity of our hypothesized mechanism driving the coalitional advantage, we examine the battlefield performance of Germany and Austria-Hungary as they fought separately and together in four battles on the Eastern Front during World War I from 1914-1915: the Russian invasion of East Prussia, Galicia, Tannenberg, and Gorlice-Tarnow.},
  keywords = {done},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8XQ4PZMH/Zielinski - Dictators Fighting Together Exploring the Battlef.pdf}
}

@article{cappellazielinski_hatchetscalpeldomestic_2019,
  title = {Hatchet or {{Scalpel}}? {{Domestic Politics}}, {{International Threats}}, and {{US Military Spending Cuts}}, 1950--2014},
  shorttitle = {Hatchet or {{Scalpel}}?},
  author = {Cappella Zielinski, Rosella and Schilde, Kaija},
  year = {2019},
  journal = {Security Studies},
  volume = {28},
  number = {4},
  pages = {677--709},
  issn = {0963-6412},
  doi = {10.1080/09636412.2019.1631379},
  urldate = {2019-07-03},
  abstract = {Budgetary cuts are characterized by distinct political, organizational, and psychological dynamics in contrast to increases. Ideally, policymakers rank, prioritize, and assess among likely strategic challenges to identify the appropriate offices, programs, line items, or service branches in which to curtail spending. Targeted cuts---preserving some line items or services while cutting others---occurred during the Eisenhower, Kennedy, Ford, and Clinton administrations. In contrast, the Nixon, H.W. Bush, and Obama administrations implemented across-the-board cuts, impacting all areas of the budget uniformly, regardless of strategic priorities. We argue that the ability of the executive to target and redirect spending commensurate with national security needs are constrained by domestic interests. However, the degree to which the threat environment is diverse conditions the number of available policy options and, in turn, executive capacity to implement targeted cuts vis-{\`a}-vis parochial interests.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/9V9YST5Z/Zielinski_Schilde_2019_Hatchet or Scalpel.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/WYVZV252/09636412.2019.html}
}

@book{cappellazielinski_howstatespay_2016,
  title = {How {{States Pay}} for {{Wars}}},
  author = {Cappella Zielinski, Rosella},
  year = {2016},
  month = jul,
  publisher = {Cornell University Press},
  abstract = {Armies fight battles, states fight wars. To focus solely on armies is to neglect the broader story of victory and defeat. Military power stems from an economic base, and without wealth, soldiers cannot be paid, weapons cannot be procured, and food cannot be bought. War finance is among the most consequential decisions any state makes: how a state finances a war affects not only its success on the battlefield but also its economic stability and its leadership tenure. In How States Pay for Wars, Rosella Cappella Zielinski clarifies several critical dynamics lying at the nexus of financial and military policy.Cappella Zielinski has built a custom database on war funding over the past two centuries, and she combines those data with qualitative analyses of Truman's financing of the Korean War, Johnson's financing of the Vietnam War, British financing of World War II and the Crimean War, and Russian and Japanese financing of the Russo-Japanese War. She argues that leaders who attempt to maximize their power at home, and state power abroad, are in a constant balancing act as they try to win wars while remaining in office. As a result of political risks, they prefer war finance policies that meet the needs of the war effort within the constraints of the capacity of the state.},
  googlebooks = {c45HDwAAQBAJ},
  isbn = {978-1-5017-0596-0},
  langid = {english}
}

