@article{heffington_mostimportantproblem_2017,
  title = {The ``{{Most Important Problem}}'' {{Dataset}} ({{MIPD}}): A New Dataset on {{American}} Issue Importance},
  shorttitle = {The ``{{Most Important Problem}}'' {{Dataset}} ({{MIPD}})},
  author = {Heffington, Colton and Park, Brandon Beomseob and Williams, Laron K},
  year = {2017},
