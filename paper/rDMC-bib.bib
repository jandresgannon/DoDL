}

@article{lin-greenberg_evaluatingescalationconceptualizing_2023,
  title = {Evaluating {{Escalation}}: {{Conceptualizing Escalation}} in an {{Era}} of {{Emerging Military Technologies}}},
  shorttitle = {Evaluating {{Escalation}}},
  author = {{Lin-Greenberg}, Erik},
  year = {2023},
  month = jan,
  journal = {The Journal of Politics},
  pages = {000--000},
  publisher = {The University of Chicago Press},
  issn = {0022-3816},
  doi = {10.1086/723974},
  urldate = {2023-04-21},
  abstract = {Escalation is central to many international relations theories. Despite its cornerstone role, conceptualizing and measuring escalation has become increasingly complicated as technologies like cyber and drone warfare proliferate. Existing escalation research often fails to account for emerging technology, and studies that do are often technology specific, comparing a single ``new'' technology to ``traditional'' forces. This siloed approach overlooks variation in the means by which states use force and their relative ordering on the escalation ladder. To address this shortcoming, I introduce a means-based framework for characterizing escalation on the basis of the degree to which actions are physically present and visible. Drawing from an original survey fielded on a cross-national sample of foreign policy experts, I construct a more complete escalation ladder in which more physically present and visible actions fall at higher rungs. This ladder suggests the need for coding schemes more precise than those found in widely cited militarized dispute data sets.},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/LPG5L5S2/Lin-Greenberg_2023_Evaluating Escalation.pdf}
}

@article{lin-greenberg_privateeyessky_2021,
  title = {Private {{Eyes}} in the {{Sky}}: {{Emerging Technology}} and the {{Political Consequences}} of {{Eroding Government Secrecy}}},
  shorttitle = {Private {{Eyes}} in the {{Sky}}},
  author = {{Lin-Greenberg}, Erik and Milonopoulos, Theo},
