  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/8JIEY4HX/Montgomery_2020_Signals of strength.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/TAK4IVUI/Montgomery_2019_Signals of strength.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/Z43KR5RN/01402390.2019.html}
