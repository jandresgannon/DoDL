  author = {Hill, Andrew and Gerras, Stephen},
  year = 2016,
  journal = {Naval War College Review},
  volume = {69},
  number = {1},
  pages = {109--132,1},
  issn = {00281484},
  urldate = {2017-11-15},
  abstract = {Successful organizations can be extraordinarily persistent and creative in denying the obvious, ignoring signals that suggest a need to challenge key strategic assumptions. The US military has been the world's unrivaled force for twenty-five years, even lacking a peer competitor in some domains -- naval operations, for example -- since 1943. A danger of such sustained success is that the military might come to view these strategic assumptions not as ideas requiring continual reassessment but as enduring laws. The current and future strategic environments demand that the military innovate and question its strategic assumptions, not because we know that they are wrong, but because every theory of competition eventually succumbs to new facts. This article explores how successful organizations focus organizational energy and attention on refining their dominant theories of competition, often resulting in dysfunctional organizational responses, or systems of denial, to strategic anomalies -- inconvenient information -- that contradict assumptions.},
  copyright = {Copyright Superintendent of Documents, U.S. Naval War College Winter 2016},
  langid = {english},
  keywords = {done,read,unsorted},
  file = {/home/andresgannon/snap/zotero-snap/common/Zotero/storage/NXE3IAEB/Hill_Gerras_2016_Systems of Denial.pdf;/home/andresgannon/snap/zotero-snap/common/Zotero/storage/PADD4ZSJ/Hill_Gerras_2016_SYSTEMS OF DENIAL.pdf}
