}

@article{maoz_structuralequivalenceinternational_2006,
  ids = {maoz_structuralequivalenceinternational_2006a},
  title = {Structural {{Equivalence}} and {{International Conflict}}: {{A Social Networks Analysis}}},
  shorttitle = {Structural {{Equivalence}} and {{International Conflict}}},
  author = {Maoz, Zeev and Kuperman, Ranan D. and Terris, Lesley and Talmud, Ilan},
  year = {2006},
